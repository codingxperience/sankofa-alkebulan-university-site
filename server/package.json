{
  "name": "sankofa-server",
  "version": "1.0.0",
  "description": "API for Sankofa Alkebulan University",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#sanitize-html": {
      "types": "./vendor/sanitize-html.d.cts",
      "default": "./vendor/sanitize-html.cjs"
    }
  },
  "scripts": {
    "vendor": "node scripts/bundle-vendor.mjs",
    "build": "prisma generate && npm run vendor && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run vendor && tsc -p tsconfig.build.json && node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env --enable-source-maps dist/cli/seed.js",
    "staff:create-owner": "node --env-file-if-exists=.env --enable-source-maps dist/cli/create-owner.js",
    "test": "npm run vendor && tsc -p tsconfig.json && node --env-file-if-exists=.env.test --enable-source-maps --test --test-concurrency=1 \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.9.9",
    "cookie": "1.1.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "esbuild": "0.28.2",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
