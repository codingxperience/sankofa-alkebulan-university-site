# Copy to server/.env for local development. On Vercel, set the same names
# under Project → Settings → Environment Variables. Never commit real values.

# ─── Database (Supabase) ───────────────────────────────────────────────────
# Transaction pooler (port 6543) for the running API.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432), used only to apply migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Connections each running instance may hold (1–20). Keep small on serverless.
DATABASE_POOL_SIZE=3
# Optional: Supabase's CA certificate (PEM) to verify the database's TLS certificate.
DATABASE_CA_CERT=

# ─── Core ──────────────────────────────────────────────────────────────────
# At least 32 random characters; keys the hashes of visitors' IP addresses.
# Generate with:  openssl rand -base64 48   (README_DEPLOY.md lists other ways)
APP_SECRET=
# The site's public address, used in every link the API emails.
PUBLIC_SITE_URL=http://localhost:4200
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to the daily maintenance job.
CRON_SECRET=
# One-time key for creating the first owner from /admin/sign-in (at least 24
# characters). It stops working once any staff account exists; remove it then.
ADMIN_SETUP_KEY=

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Without these, emails are kept in the outbox and sent once they are set.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Sankofa Alkebulan University <office@your-domain>".
EMAIL_FROM=
EMAIL_REPLY_TO=sanalkeu@outlook.com
# Comma-separated; alerted about new messages until offices are configured in the console.
STAFF_NOTIFICATION_EMAILS=sanalkeu@outlook.com

# ─── Card payments (Flutterwave, optional) ─────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" set on the Flutterwave dashboard's webhook settings.
FLUTTERWAVE_WEBHOOK_HASH=

# ─── Local only ────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
