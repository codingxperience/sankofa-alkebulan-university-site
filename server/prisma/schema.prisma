// Sankofa Alkebulan University — data model.
//
// Every table lives in the private `sankofa` schema. Supabase only exposes
// the `public` schema through its Data API, so nothing here is reachable
// with an anon key; the API server is the single door to this data.
//
// Conventions
//   * ids are UUIDv7: time-ordered, so primary-key indexes stay compact.
//   * tables and columns are snake_case in the database, camelCase in code.
//   * every timestamp is timestamptz.
//   * `reference`, `number` and `code` columns are the short identifiers
//     people read aloud on the phone; ids never leave the admin console.
//   * `client_request_id` makes public submissions idempotent: a retried
//     request returns the record created the first time.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  runtime                = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── Staff, sessions and the audit trail ──────────────────────────────────

enum StaffRole {
  OWNER
  ADMIN
  ADMISSIONS
  COMMUNICATIONS
  EVENTS
  COMMERCE
  VIEWER
}

enum StaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum StaffTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

/// The seven doors a message can be routed to — mirrors the contact page.
enum Office {
  ADMISSIONS
  PROGRAMMES
  RESEARCH
  STUDENT_LIFE
  GOVERNANCE
  MEDIA
  CENTRAL
}

model StaffMember {
  id                String      @id @default(uuid(7)) @db.Uuid
  email             String      @unique
  name              String
  title             String?
  roles             StaffRole[]
  offices           Office[]
  status            StaffStatus @default(INVITED)
  passwordHash      String?     @map("password_hash")
  passwordChangedAt DateTime?   @map("password_changed_at") @db.Timestamptz(3)
  failedSignIns     Int         @default(0) @map("failed_sign_ins")
  lockedUntil       DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastSignInAt      DateTime?   @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions             StaffSession[]
  tokens               StaffToken[]      @relation("TokenOwner")
  tokensIssued         StaffToken[]      @relation("TokenIssuer")
  auditEvents          AuditEvent[]
  assignedInquiries    Inquiry[]
  inquiryNotes         InquiryNote[]
  assignedApplications Application[]
  applicationNotes     ApplicationNote[]
  articlesCreated      Article[]         @relation("ArticleCreatedBy")
  articlesUpdated      Article[]         @relation("ArticleUpdatedBy")
  officeRoutesUpdated  OfficeRoute[]

  @@map("staff_members")
}

model StaffSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, revokedAt])
  @@index([expiresAt])
  @@map("staff_sessions")
}

model StaffToken {
  id         String            @id @default(uuid(7)) @db.Uuid
  staffId    String            @map("staff_id") @db.Uuid
  purpose    StaffTokenPurpose
  tokenHash  String            @unique @map("token_hash")
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?         @map("used_at") @db.Timestamptz(3)
  issuedById String?           @map("issued_by_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  staff    StaffMember  @relation("TokenOwner", fields: [staffId], references: [id], onDelete: Cascade)
  issuedBy StaffMember? @relation("TokenIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([staffId, purpose])
  @@map("staff_tokens")
}

/// Append-only record of every change made through the admin console and of
/// security-relevant events (sign-ins, lockouts, password changes).
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String   @map("actor_label")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  summary    String
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor StaffMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_events")
}

// ─── Platform plumbing ────────────────────────────────────────────────────

/// Fixed-window counters shared by every serverless instance.
/// `key` is a SHA-256 digest, so raw IP addresses are never stored.
model RateLimitBucket {
  key     String   @id
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  UNDELIVERABLE
}

/// Transactional outbox. Messages are rendered and stored in the same
/// transaction as the change that caused them, then delivered by a worker,
/// so a slow or failing mail provider never loses or blocks a submission.
model OutboundEmail {
  id                String      @id @default(uuid(7)) @db.Uuid
  template          String
  toAddress         String      @map("to_address")
  toName            String?     @map("to_name")
  replyTo           String?     @map("reply_to")
  subject           String
  html              String
  text              String
  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  lastError         String?     @map("last_error")
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)
  providerMessageId String?     @map("provider_message_id")
  relatedType       String?     @map("related_type")
  relatedId         String?     @map("related_id")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([relatedType, relatedId])
  @@map("outbound_emails")
}

/// Where each office's mail goes and how fast it promises to answer.
model OfficeRoute {
  office         Office   @id
  label          String
  notifyEmails   String[] @map("notify_emails")
  responseTarget String   @map("response_target")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById    String?  @map("updated_by_id") @db.Uuid

  updatedBy StaffMember? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("office_routes")
}

// ─── Inquiries ────────────────────────────────────────────────────────────

enum InquirySource {
  CONTACT_PAGE
  ADMISSIONS_DESK
  PORTAL_FORM
}

enum InquiryStatus {
  NEW
  OPEN
  AWAITING_REPLY
  RESOLVED
  SPAM
}

model Inquiry {
  id              String        @id @default(uuid(7)) @db.Uuid
  reference       String        @unique
  office          Office
  source          InquirySource
  status          InquiryStatus @default(NEW)
  name            String
  email           String
  origin          String?
  subject         String?
  message         String
  details         Json?
  assigneeId      String?       @map("assignee_id") @db.Uuid
  firstRepliedAt  DateTime?     @map("first_replied_at") @db.Timestamptz(3)
  resolvedAt      DateTime?     @map("resolved_at") @db.Timestamptz(3)
  clientRequestId String?       @unique @map("client_request_id") @db.Uuid
  submitterHash   String?       @map("submitter_hash")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignee StaffMember?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notes    InquiryNote[]

  @@index([status, office, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@index([assigneeId, status])
  @@map("inquiries")
}

enum NoteKind {
  NOTE
  REPLY
}

model InquiryNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  inquiryId String   @map("inquiry_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  kind      NoteKind @default(NOTE)
  body      String
  emailId   String?  @map("email_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inquiry Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  StaffMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt])
  @@map("inquiry_notes")
}

// ─── Admissions ───────────────────────────────────────────────────────────

enum ApplicationPathway {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORAL
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CONDITIONAL_OFFER
  OFFER
  WAITLISTED
  DECLINED
  WITHDRAWN
}

/// One application, from first keystroke to decision. Section answers live in
/// `answers` (validated per section by the API); the columns beside it are the
/// handful of facts the admissions team sorts and filters on.
model Application {
  id              String             @id @default(uuid(7)) @db.Uuid
  reference       String             @unique
  pathway         ApplicationPathway
  intake          String
  status          ApplicationStatus  @default(DRAFT)
  email           String?
  givenName       String?            @map("given_name")
  familyName      String?            @map("family_name")
  residence       String?
  firstChoice     String?            @map("first_choice")
  answers         Json               @default("{}")
  completedSteps  String[]           @map("completed_steps")
  version         Int                @default(1)
  resumeTokenHash String             @unique @map("resume_token_hash")
  assigneeId      String?            @map("assignee_id") @db.Uuid
  submittedAt     DateTime?          @map("submitted_at") @db.Timestamptz(3)
  decidedAt       DateTime?          @map("decided_at") @db.Timestamptz(3)
  clientRequestId String?            @unique @map("client_request_id") @db.Uuid
  submitterHash   String?            @map("submitter_hash")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignee StaffMember?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notes    ApplicationNote[]

  @@index([status, pathway, submittedAt(sort: Desc)])
  @@index([email])
  @@index([createdAt(sort: Desc)])
  @@map("applications")
}

model ApplicationNote {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  authorId      String?  @map("author_id") @db.Uuid
  body          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      StaffMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_notes")
}

// ─── Events ───────────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

/// `options` holds the choice lists a registration form offers
/// (attendee categories, ways to join, days, themes). The API accepts only
/// values listed here, so the event — not the browser — defines the form.
model Event {
  id                   String      @id @default(uuid(7)) @db.Uuid
  slug                 String      @unique
  title                String
  summary              String?
  venue                String?
  timezone             String      @default("Africa/Kampala")
  startsAt             DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime?   @map("ends_at") @db.Timestamptz(3)
  registrationClosesAt DateTime?   @map("registration_closes_at") @db.Timestamptz(3)
  capacity             Int?
  status               EventStatus @default(DRAFT)
  options              Json        @default("{}")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations EventRegistration[]

  @@index([status, startsAt])
  @@map("events")
}

model EventRegistration {
  id               String             @id @default(uuid(7)) @db.Uuid
  eventId          String             @map("event_id") @db.Uuid
  code             String             @unique
  status           RegistrationStatus @default(CONFIRMED)
  name             String
  email            String
  phone            String?
  place            String?
  organisation     String?
  role             String?
  attendeeCategory String?            @map("attendee_category")
  attendanceMode   String?            @map("attendance_mode")
  days             String?
  interests        String[]
  question         String?
  accessNeeds      String?            @map("access_needs")
  wantsUpdates     Boolean            @default(false) @map("wants_updates")
  checkedInAt      DateTime?          @map("checked_in_at") @db.Timestamptz(3)
  cancelledAt      DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  clientRequestId  String?            @unique @map("client_request_id") @db.Uuid
  submitterHash    String?            @map("submitter_hash")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId, status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("event_registrations")
}

// ─── Store ────────────────────────────────────────────────────────────────

enum ProductKind {
  APPAREL
  ARTIFACT
  BOOK
  DIGITAL
  MEDIA
  MERCHANDISE
}

enum ProductStatus {
  AVAILABLE
  PREORDER
  SOLD_OUT
  ARCHIVED
}

/// Commerce facts only: price, availability and stock. Imagery and long-form
/// copy stay with the storefront, keyed by `sku`.
model Product {
  id             String        @id @default(uuid(7)) @db.Uuid
  sku            String        @unique
  name           String
  kind           ProductKind
  status         ProductStatus @default(AVAILABLE)
  priceCents     Int           @map("price_cents")
  currency       String        @default("USD")
  hasSizes       Boolean       @default(false) @map("has_sizes")
  isDigital      Boolean       @default(false) @map("is_digital")
  stockRemaining Int?          @map("stock_remaining")
  position       Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([status, position])
  @@map("products")
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  FULFILLING
  DISPATCHED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
  REFUNDED
}

enum FulfilmentMethod {
  DIGITAL
  PICKUP
  COURIER
  EXPRESS
}

enum PaymentRail {
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id               String           @id @default(uuid(7)) @db.Uuid
  number           String           @unique
  status           OrderStatus      @default(AWAITING_PAYMENT)
  customerName     String           @map("customer_name")
  customerEmail    String           @map("customer_email")
  customerPhone    String?          @map("customer_phone")
  deliveryAddress  String?          @map("delivery_address")
  fulfilment       FulfilmentMethod
  paymentRail      PaymentRail      @map("payment_rail")
  paymentStatus    PaymentStatus    @default(UNPAID) @map("payment_status")
  paymentProvider  String?          @map("payment_provider")
  paymentReference String?          @unique @map("payment_reference")
  currency         String           @default("USD")
  subtotalCents    Int              @map("subtotal_cents")
  deliveryCents    Int              @map("delivery_cents")
  totalCents       Int              @map("total_cents")
  accessKeyHash    String           @map("access_key_hash")
  staffNote        String?          @map("staff_note")
  paidAt           DateTime?        @map("paid_at") @db.Timestamptz(3)
  cancelledAt      DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  clientRequestId  String?          @unique @map("client_request_id") @db.Uuid
  submitterHash    String?          @map("submitter_hash")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  items         OrderItem[]
  paymentEvents PaymentEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  sku            String
  name           String
  size           String?
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")
  lineTotalCents Int     @map("line_total_cents")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Raw provider callbacks, kept for reconciliation. The unique pair makes
/// webhook processing idempotent: a replayed delivery is recognised and ignored.
model PaymentEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  provider        String
  providerEventId String   @map("provider_event_id")
  orderId         String?  @map("order_id") @db.Uuid
  kind            String
  outcome         String
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([orderId])
  @@map("payment_events")
}

// ─── Journal ──────────────────────────────────────────────────────────────

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// An article is public when status = PUBLISHED and published_at <= now(),
/// which is how scheduling works without a separate job.
model Article {
  id             String                   @id @default(uuid(7)) @db.Uuid
  slug           String                   @unique
  title          String
  excerpt        String
  bodyHtml       String                   @map("body_html")
  coverImageUrl  String?                  @map("cover_image_url")
  authorName     String                   @map("author_name")
  categories     String[]
  tags           String[]
  readingMinutes Int                      @default(1) @map("reading_minutes")
  status         ArticleStatus            @default(DRAFT)
  publishedAt    DateTime?                @map("published_at") @db.Timestamptz(3)
  searchVector   Unsupported("tsvector")? @map("search_vector")
  createdById    String?                  @map("created_by_id") @db.Uuid
  updatedById    String?                  @map("updated_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy StaffMember? @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy StaffMember? @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@index([searchVector], type: Gin)
  @@index([categories], type: Gin)
  @@index([tags], type: Gin)
  @@map("articles")
}

// ─── Audience ─────────────────────────────────────────────────────────────

enum SubscriberSource {
  NEWSLETTER
  EVENT_REGISTRATION
  STORE_ORDER
  ADMISSIONS
  ADMIN
}

/// People who explicitly asked to hear from the university. The consent
/// wording they agreed to is stored with the timestamp, so it can be shown
/// exactly as it was if anyone asks.
model Subscriber {
  id             String           @id @default(uuid(7)) @db.Uuid
  email          String           @unique
  name           String?
  source         SubscriberSource
  consentText    String           @map("consent_text")
  consentedAt    DateTime         @map("consented_at") @db.Timestamptz(3)
  unsubscribedAt DateTime?        @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([unsubscribedAt, createdAt(sort: Desc)])
  @@map("subscribers")
}
